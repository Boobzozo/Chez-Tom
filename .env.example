# Copier ce fichier en `.env` et remplir les valeurs.
# En local (`npm run dev`), tout est facultatif.

# ===========================================================================
#  DÉPLOIEMENT — lu par docker-compose.yml uniquement
#  Ce sont les SEULES valeurs qui changent d'un serveur à l'autre.
# ===========================================================================

# Domaine sur lequel le site répond. Traefik demande le certificat pour ce nom,
# et le serveur s'en sert pour le retour OAuth Google (APP_URL en découle).
#   démo    : demo.srv1043923.hstgr.cloud
#   final   : tombarbershop.fr
APP_HOST="demo.srv1043923.hstgr.cloud"

# Réseau Docker sur lequel tourne Traefik (`docker network ls` pour le trouver).
# VPS actuel (template n8n de Hostinger) : root_default
# Architecture cible sur le prochain VPS  : proxy
PROXY_NETWORK="root_default"

# Nom du résolveur de certificats déclaré dans la configuration de Traefik.
CERT_RESOLVER="mytlschallenge"

# Fuseau horaire du planning (à garder tel quel en France).
TZ="Europe/Paris"

# ===========================================================================
#  APPLICATION
# ===========================================================================

# --- Développement local uniquement -----------------------------------------
# En Docker, ces quatre valeurs sont imposées par docker-compose.yml : les
# renseigner ici n'aurait aucun effet.
#
# PORT=3000
# DB_PATH=""        # défaut : chez-tom.db à côté de server.ts
# UPLOADS_DIR=""    # défaut : uploads/ à côté de server.ts
# APP_URL=""        # défaut en Docker : https://$APP_HOST

# --- Google Calendar (facultatif) -------------------------------------------
# Identifiants OAuth à créer sur https://console.cloud.google.com, API Calendar
# activée. URL de redirection à déclarer : https://<APP_HOST>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Agenda Google à utiliser (facultatif). Si renseigné, le site lit/écrit dans CET
# agenda et ses événements bloquent les créneaux. Sinon, il se choisit dans
# l'espace gérant.
GOOGLE_CALENDAR_ID=""

# --- E-mails de confirmation (facultatif) -----------------------------------
# https://resend.com — si RESEND_API_KEY est vide, le site n'envoie aucun e-mail.
RESEND_API_KEY=""

# `onboarding@resend.dev` est le bac à sable Resend : il ne délivre QU'À l'adresse
# du compte Resend. En production, vérifier un domaine chez Resend puis mettre :
# MAIL_FROM="Tom Barber <rendez-vous@tombarbershop.fr>"
MAIL_FROM="Tom Barber <onboarding@resend.dev>"

# --- Webhooks n8n (facultatifs — vides = désactivés) ------------------------
# Réservation : Google Agenda + Google Sheets + e-mail.
N8N_BOOKING_WEBHOOK_URL=""
# Notification Telegram du gérant.
N8N_TELEGRAM_WEBHOOK_URL=""
