# Copier ce fichier en `.env` et remplir les valeurs. Tout est facultatif pour tester en local.

# Port du serveur (3000 par défaut)
PORT=3000

# Fuseau horaire du planning (Europe/Paris par défaut si absent — à garder tel quel en France).
TZ=Europe/Paris

# Emplacement de la base SQLite. Par défaut : `chez-tom.db` à côté de server.ts,
# quel que soit le dossier depuis lequel le serveur est lancé.
DB_PATH=""

# Dossier des photos de la galerie (servi sur /uploads). Par défaut : `uploads/` à côté
# de server.ts. À sauvegarder avec la base.
UPLOADS_DIR=""

# URL publique du site (sans slash final).
# Utilisée pour le retour OAuth Google Calendar, ex. https://tom-barber.fr
APP_URL=""

# Intégration Google Calendar (facultative) — identifiants OAuth
# à créer sur https://console.cloud.google.com (API Calendar activée).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Agenda Google à utiliser (facultatif). Si renseigné, le site lit/écrit dans CET agenda
# (ses événements bloquent les créneaux). Sinon, l'agenda se choisit dans l'espace gérant.
# Ex. : ee86a0b7d420e0cc5fcc0ef76b35cb5518de5f2afa5a5ba5654a8eb34807c6ee@group.calendar.google.com
GOOGLE_CALENDAR_ID=""

# Email de confirmation via Resend (facultatif — https://resend.com).
# Si RESEND_API_KEY est vide, aucun email n'est envoyé par le site (n8n peut s'en charger).
RESEND_API_KEY=""
# Expéditeur. `onboarding@resend.dev` est le bac à sable Resend : il ne livre QU'À l'adresse
# du compte Resend. En production, vérifier un domaine chez Resend et mettre par ex. :
# MAIL_FROM="Tom Barber <rendez-vous@tom-barber.fr>"
MAIL_FROM="Tom Barber <onboarding@resend.dev>"

# Webhooks n8n après réservation (facultatifs — vides = désactivés).
# Réservation : Google Agenda + Google Sheets + email. Ex. :
# N8N_BOOKING_WEBHOOK_URL="https://n8n.srv1043923.hstgr.cloud/webhook/reservation-chez-tom"
N8N_BOOKING_WEBHOOK_URL=""
# Notification Telegram du gérant. Ex. :
# N8N_TELEGRAM_WEBHOOK_URL="https://n8n.srv1043923.hstgr.cloud/webhook/notification-telegram"
N8N_TELEGRAM_WEBHOOK_URL=""
